# Copy to .env (chmod 600). Never commit .env.
DEFAULT_DOMAIN=link.wwbb.dev
IS_HTTPS_ENABLED=true
# Generate with: openssl rand -base64 32 | tr -d '/+=' 
DB_PASSWORD=
# Optional: free MaxMind GeoLite2 key for visit geolocation. Blank disables it.
GEOLITE_LICENSE_KEY=
# Optional: where the bare domain and unknown short codes redirect.
DEFAULT_BASE_URL_REDIRECT=
DEFAULT_INVALID_SHORT_URL_REDIRECT=
SHLINK_PORT=8085
WEB_CLIENT_PORT=8086
